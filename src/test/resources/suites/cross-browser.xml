<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Ejecuta todas las pruebas en Google Chrome y Microsoft Edge EN PARALELO (un hilo por navegador).
  Uso: mvn clean test -Dsuite=cross-browser
-->
<suite name="E-commerce E2E - Cross-browser" parallel="tests" thread-count="2" verbose="1">
    <test name="Google Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.idat.qa.tests"/>
            <package name="com.idat.qa.tests.negative"/>
        </packages>
    </test>
    <test name="Microsoft Edge">
        <parameter name="browser" value="edge"/>
        <packages>
            <package name="com.idat.qa.tests"/>
            <package name="com.idat.qa.tests.negative"/>
        </packages>
    </test>
</suite>
